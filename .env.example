# Demo works with no keys. Node >=22.13 required.
DATABASE_URL=file:./data/handos.sqlite
DISCOVERY_PROVIDER=mock
SERPAPI_KEY=
OPENAI_API_KEY=
SENDGRID_API_KEY=
HUNTER_API_KEY=
EMAIL_PROVIDER=demo
# Live sending only runs through the authenticated /api/jobs/run endpoint.
LIVE_EMAIL_ENABLED=false
SENDGRID_SANDBOX=true
EMAIL_BATCH_LIMIT=10
SENDGRID_WEBHOOK_PUBLIC_KEY=
UNSUBSCRIBE_SECRET=
REPLY_TO_EMAIL=
APP_URL=http://localhost:3000
SCHEDULING_URL=https://handos.co
# Set for non-local access; browser uses HTTP Basic login when configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required for external event ingestion and scheduler endpoints.
WEBHOOK_SECRET=
CRON_SECRET=
FROM_EMAIL=
FROM_NAME=Handos
POSTAL_ADDRESS=
